<view class="page result-page">
  <view class="shell">
    <view wx:if="{{!result}}" class="card empty-card">
      <view class="empty-symbol">卦</view>
      <view class="section-title">暂无结果</view>
      <view class="small empty-copy">请先到起卦页生成一局。</view>
      <button class="btn" bindtap="onNewDivination">去起卦</button>
    </view>

    <view wx:else>
      <view class="card summary-card fade-up">
        <view class="result-kicker">本卦与变卦</view>
        <view class="result-title">{{result.original.name}}{{result.changed ? ' 之 ' + result.changed.name : '（六爻安静）'}}</view>
        <view class="result-question">{{result.question || '未填写占问事项'}}</view>

        <view class="summary-meta">
          <view class="summary-date">{{result.date}} · {{formatHour(result.hour)}}</view>
          <view class="method-pill">{{methodName(result.method)}}</view>
        </view>

        <view class="calendar-strip">
          <view class="calendar-item">
            <text class="calendar-label">太岁</text>
            <text>{{result.yearGanZhi || '—'}}</text>
          </view>
          <view class="calendar-item">
            <text class="calendar-label">月建</text>
            <text>{{result.monthJian}}</text>
          </view>
          <view class="calendar-item">
            <text class="calendar-label">日辰</text>
            <text>{{result.dayGanZhi}}</text>
          </view>
          <view class="calendar-item">
            <text class="calendar-label">旬空</text>
            <text>{{result.xunKong}}</text>
          </view>
        </view>

        <view class="summary-actions">
          <button class="summary-btn" bindtap="onCopySummary">复制摘要</button>
          <button class="summary-btn" bindtap="openSettings">AI 设置</button>
          <button class="summary-btn accent" bindtap="onNewDivination">重新起卦</button>
        </view>
      </view>

      <view class="card fade-up">
        <view class="section-head">
          <view class="section-title">卦体与变爻</view>
          <view class="change-count">{{changedText}}</view>
        </view>

        <view class="gua-board">
          <view class="gua-row" wx:for="{{rows}}" wx:key="label">
            <view class="gua-position">{{item.label}}</view>
            <view class="gua-line-wrap">
              <view class="hex-line {{item.isYin ? 'yin' : 'yang'}}">
                <view wx:if="{{item.isYin}}" class="hex-segment"></view>
                <view wx:if="{{item.isYin}}" class="hex-segment"></view>
              </view>
            </view>
            <view class="gua-detail">
              <view class="gua-primary">{{item.sixShen}} · {{item.sixQin}} {{item.naJia}}</view>
              <view class="gua-secondary">{{item.fullYao}}{{item.ws ? ' · ' + item.ws : ''}}{{item.shi ? ' · 世' : ''}}{{item.ying ? ' · 应' : ''}}</view>
            </view>
            <view wx:if="{{item.isChanging}}" class="gua-change">→ {{item.changed}}</view>
          </view>
        </view>

        <view wx:if="{{relationTags && relationTags.length > 0}}" class="tag-row">
          <view class="tag" wx:for="{{relationTags}}" wx:key="*this">{{item}}</view>
        </view>

        <view wx:if="{{fushenText}}" class="fushen-panel">
          <text class="fushen-label">伏神</text>
          <text>{{fushenText}}</text>
        </view>
      </view>

      <view class="card fade-up">
        <view class="section-title">经典判词</view>
        <view wx:if="{{lify = interpretations.length > 0}}" class="interpretation-list">
          <view class="interpretation-item" wx:for="{{interpretations}}" wx:key="*this">{{item}}</view>
        </view>
      </view>

      <view class="card fade-up">
        <view class="section-title">动静爻辞</view>
        <view class="yaoci-list">
          <view class="yaoci-item {{item.isChanging ? 'is-changing' : ''}}" wx:for="{{rows}}" wx:key="label">
            <view class="yaoci-head">
              <text class="yaoci-position">{{item.label}}{{item.isYin ? '六' : '九'}}</text>
              <text wx:if="{{item.isChanging}}" class="moving-pill">动爻</text>
            </view>
            <view class="yaoci-text">{{item.originalLineText}}</view>
            <view wx:if="{{item.isChanging}}" class="yaoci-change">变：{{item.changedLineText}}</view>
            <view wx:if="{{item.tags}}" class="yaoci-tags">{{item.tags}}</view>
          </view>
        </view>
      </view>

      <view class="card fade-up ai-card">
        <view class="section-head">
          <view class="section-title">AI 深度解读</view>
          <view class="ai-state">{{isConfigured ? '已配置' : '未配置'}}</view>
        </view>

        <view wx:if="{{!aiText}}" class="ai-intro">
          <view class="ai-mark">AI</view>
          <view class="small">{{aiLoading ? '正在结合卦象、动爻与日月信息生成解读…' : '可在经典断语基础上，获得更完整的结构化分析。'}}</view>
        </view>

        <view wx:if="{{!aiLoading && !aiText}}" class="action-row">
          <button class="btn" bindtap="onRunAI">开始解读</button>
          <button class="btn ghost secondary-action" bindtap="onTestAI">测试连接</button>
        </view>

        <view wx:if="{{aiLoading}}" class="action-row">
          <button class="btn" loading="true">解读中</button>
          <button class="btn ghost secondary-action" bindtap="onStopAI">停止</button>
        </view>

        <view wx:if="{{aiText}}" class="ai-content">{{aiText}}</view>
      </view>

      <view class="card fade-up" wx:if="{{historyCount > 0}}">
        <view class="section-head">
          <view class="section-title">历史记录</view>
          <view class="history-count">{{historyCount}} 局</view>
        </view>
        <view class="history-list">
          <view class="history-item" wx:for="{{history}}" wx:key="id">
            <view class="history-main">
              <view class="history-name">{{item.original.name}}{{item.changed ? ' → ' + item.changed.name : ''}}</view>
              <view class="history-date">{{item.date}}</view>
            </view>
            <button class="history-btn" bindtap="onLoadHistory" data-id="{{item.id}}">查看</button>
            <button class="history-btn danger" bindtap="onDeleteHistory" data-id="{{item.id}}">删除</button>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
