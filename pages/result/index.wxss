.result-page {
  padding-top: 34rpx;
}

.empty-card {
  margin-top: 100rpx;
  text-align: center;
}

.empty-symbol {
  width: 104rpx;
  height: 104rpx;
  margin: 4rpx auto 26rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff8ed;
  background: var(--jade);
  font-size: 44rpx;
}

.empty-card .section-title {
  justify-content: center;
}

.empty-card .section-title::before {
  display: none;
}

.empty-copy {
  margin: 0 0 24rpx;
}

.summary-card {
  padding-top: 34rpx;
}

.result-kicker {
  color: var(--cinnabar);
  font-size: 20rpx;
  letter-spacing: 4rpx;
}

.result-title {
  margin-top: 10rpx;
  color: var(--ink);
  font-size: 45rpx;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: 3rpx;
}

.result-question {
  margin-top: 18rpx;
  color: var(--ink-soft);
  font-size: 25rpx;
  line-height: 1.7;
}

.summary-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
}

.summary-date {
  color: var(--ink-soft);
  font-size: 22rpx;
}

.method-pill,
.change-count,
.history-count,
.ai-state {
  flex: 0 0 auto;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: var(--jade);
  background: rgba(70, 125, 114, 0.1);
  font-size: 20rpx;
}

.calendar-strip {
  display: flex;
  margin-top: 22rpx;
  border: 1rpx solid rgba(126, 91, 67, 0.12);
  border-radius: 16rpx;
  background: rgba(255, 252, 245, 0.5);
}

.calendar-item {
  flex: 1;
  padding: 15rpx 6rpx;
  border-right: 1rpx solid rgba(126, 91, 67, 0.12);
  color: var(--ink);
  font-size: 22rpx;
  text-align: center;
}

.calendar-item:last-child {
  border-right: 0;
}

.calendar-label {
  display: block;
  margin-bottom: 5rpx;
  color: var(--muted);
  font-size: 18rpx;
}

.summary-actions {
  display: flex;
  gap: 10rpx;
  margin-top: 22rpx;
}

.summary-btn {
  flex: 1;
  min-width: 0;
  min-height: 66rpx;
  margin: 0;
  padding: 0 10rpx;
  border: 1rpx solid rgba(126, 91, 67, 0.2);
  border-radius: 14rpx;
  color: var(--ink-soft);
  background: transparent;
  font-size: 22rpx;
  line-height: 66rpx;
}

.summary-btn::after {
  border: 0;
}

.summary-btn.accent {
  color: #fff8ed;
  border-color: var(--cinnabar);
  background: var(--cinnabar);
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.section-head .section-title {
  margin-bottom: 20rpx;
}

.gua-board {
  overflow: hidden;
  border: 1rpx solid rgba(126, 91, 67, 0.12);
  border-radius: 18rpx;
  background: rgba(255, 252, 245, 0.46);
}

.gua-row {
  min-height: 94rpx;
  display: flex;
  align-items: center;
  gap: 13rpx;
  padding: 12rpx 14rpx;
  border-bottom: 1rpx solid rgba(126, 91, 67, 0.1);
  box-sizing: border-box;
}

.gua-row:last-child {
  border-bottom: 0;
}

.gua-position {
  width: 30rpx;
  flex: 0 0 30rpx;
  color: var(--muted);
  font-size: 21rpx;
  text-align: center;
}

.gua-line-wrap {
  width: 154rpx;
  flex: 0 0 154rpx;
}

.gua-line-wrap .hex-line.yang,
.gua-line-wrap .hex-line.yin {
  width: 150rpx;
  height: 14rpx;
}

.gua-line-wrap .hex-line.yin {
  gap: 22rpx;
}

.gua-line-wrap .hex-line.yin .hex-segment {
  flex: 1;
  width: auto;
  height: 14rpx;
}

.gua-detail {
  flex: 1;
  min-width: 0;
}

.gua-primary {
  overflow: hidden;
  color: var(--ink);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gua-secondary {
  overflow: hidden;
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 19rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gua-change {
  width: 66rpx;
  flex: 0 0 66rpx;
  color: var(--cinnabar);
  font-size: 20rpx;
  text-align: right;
  white-space: nowrap;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.fushen-panel {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 15rpx 16rpx;
  border-radius: 14rpx;
  color: var(--ink-soft);
  background: rgba(196, 147, 78, 0.1);
  font-size: 21rpx;
  line-height: 1.6;
}

.fushen-label {
  flex: 0 0 auto;
  color: var(--cinnabar);
  font-weight: 700;
}

.interpretation-list {
  counter-reset: reading;
}

.interpretation-item {
  position: relative;
  padding: 17rpx 0 17rpx 34rpx;
  border-bottom: 1rpx solid rgba(126, 91, 67, 0.1);
  color: var(--ink-soft);
  font-size: 24rpx;
  line-height: 1.85;
}

.interpretation-item:last-child {
  border-bottom: 0;
}

.interpretation-item::before {
  content: "";
  position: absolute;
  left: 4rpx;
  top: 31rpx;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: var(--gold);
}

.yaoci-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(126, 91, 67, 0.1);
}

.yaoci-item:last-child {
  border-bottom: 0;
}

.yaoci-item.is-changing {
  padding-left: 16rpx;
  border-left: 5rpx solid var(--cinnabar);
}

.yaoci-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 9rpx;
}

.yaoci-position {
  color: var(--ink);
  font-size: 23rpx;
  font-weight: 700;
}

.moving-pill {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  color: var(--cinnabar);
  background: rgba(180, 71, 61, 0.1);
  font-size: 18rpx;
}

.yaoci-text,
.yaoci-change,
.yaoci-tags {
  color: var(--ink-soft);
  font-size: 22rpx;
  line-height: 1.75;
}

.yaoci-change {
  margin-top: 8rpx;
  color: var(--cinnabar);
}

.yaoci-tags {
  margin-top: 6rpx;
  color: var(--jade);
}

.ai-intro {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: rgba(70, 125, 114, 0.08);
}

.ai-mark {
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: var(--jade);
  font-family: sans-serif;
  font-size: 20rpx;
  font-weight: 700;
}

.ai-card .secondary-action {
  flex: 0 0 170rpx;
}

.ai-content {
  color: var(--ink-soft);
  font-size: 24rpx;
  line-height: 1.9;
  white-space: pre-wrap;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 17rpx 0;
  border-bottom: 1rpx solid rgba(126, 91, 67, 0.1);
}

.history-item:last-child {
  border-bottom: 0;
}

.history-main {
  flex: 1;
  min-width: 0;
}

.history-name {
  overflow: hidden;
  color: var(--ink);
  font-size: 23rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-date {
  overflow: hidden;
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-btn {
  min-height: 52rpx;
  margin: 0;
  padding: 0 14rpx;
  border: 1rpx solid rgba(126, 91, 67, 0.2);
  border-radius: 12rpx;
  color: var(--ink-soft);
  background: transparent;
  font-size: 19rpx;
  line-height: 52rpx;
}

.history-btn::after {
  border: 0;
}

.history-btn.danger {
  color: var(--cinnabar);
}

.small {
  color: var(--ink-soft);
  font-size: 22rpx;
  line-height: 1.7;
}
